{
  "name": "verdant-audio",
  "version": "0.1.0",
  "private": true,
  "description": "Green, audio-reactive desktop music experience.",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.kevinlabs.verdantaudio",
    "productName": "Verdant Audio",
    "directories": { "output": "release" },
    "files": ["src/**/*", "package.json"],
    "win": {
      "target": ["nsis"],
      "artifactName": "Verdant-Audio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
